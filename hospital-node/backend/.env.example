# RESPIRA AI — Hospital Node Backend Configuration Template
SECRET_KEY=django-insecure-hospital-node-template-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Hospital Node Local PostgreSQL Database Infrastructure (respira_hospital)
DB_NAME=respira_hospital
DB_USER=postgres
DB_PASSWORD=ds@585800
DB_HOST=127.0.0.1
DB_PORT=5432

# Cloud Control Plane Integration Settings
RESPIRA_CLOUD_URL=http://127.0.0.1:8002/api
RESPIRA_HOSPITAL_CODE=HOSP-DEMO
RESPIRA_NODE_ID=NODE-HOSP-DEMO-01
RESPIRA_NODE_VERSION=0.1.0
RESPIRA_HEARTBEAT_INTERVAL=60

# CORS Configuration for Local Hospital Node Frontend (Port 5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# X-Ray Ingestion Storage Directories
XRAY_INCOMING_DIR=../storage/incoming_xrays
